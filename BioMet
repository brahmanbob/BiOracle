package com.bioracle.rppg

/**
 * Biometric output structure matching TypeScript SovereignLogic.ts interface
 */
data class BiometricData(
    val timestamp: Long,           // Unix timestamp (ms)
    val heartRate: Double,         // BPM
    val rmssd: Double,            // HRV - parasympathetic activity (ms)
    val sdnn: Double,             // HRV - overall variability (ms)
    val coherenceRatio: Double,   // Parasympathetic/Sympathetic balance
    val breathingRate: Double,    // Estimated respiratory rate (breaths/min)
    val waveformQuality: Double   // Signal quality metric (0-1)
)

data class BiometricHistory(
    val last5heartRates: List<Double>,
    val last5rmssd: List<Double>,
    val last5timestamps: List<Long>
)

/**
 * Translates HRVResult to BiometricData for UI/export
 */
fun hrvToBiometricData(
    hrvResult: HRVResult, 
    timestamp: Long = System.currentTimeMillis()
): BiometricData {
    // RMSSD reflects parasympathetic tone
    // Ratio: High RMSSD + low HR = recovery state
    val coherence = when {
        hrvResult.rmssd > 50 && hrvResult.hr < 70 -> 0.85
        hrvResult.rmssd > 30 -> 0.65
        hrvResult.rmssd > 15 -> 0.45
        else -> 0.25
    }
    
    // Estimate breathing rate from HRV (respiratory sinus arrhythmia)
    val breathingRate = if (hrvResult.ibiSequence.size > 5) {
        // Approximate from IBI peak frequencies (simplified)
        val meanIbi = hrvResult.ibiSequence.average()
        60000.0 / meanIbi / 4.0  // ~4 heartbeats per breath typical
    } else {
        15.0  // Default resting rate
    }.coerceIn(8.0, 25.0)
    
    // Simple waveform quality metric (would be more sophisticated in production)
    val quality = when {
        hrvResult.ibiSequence.size < 10 -> 0.3
        hrvResult.rmssd > 100 -> 0.5  // suspiciously high
        hrvResult.hr in 40.0..100.0 -> 0.9
        else -> 0.7
    }.coerceAtMost(1.0)
    
    return BiometricData(
        timestamp = timestamp,
        heartRate = hrvResult.hr,
        rmssd = hrvResult.rmssd,
        sdnn = hrvResult.sdnn,
        coherenceRatio = coherence,
        breathingRate = breathingRate,
        waveformQuality = quality
    )
}
