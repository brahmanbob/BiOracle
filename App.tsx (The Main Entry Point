
import React, { useState } from 'react';
import { View, Text, TouchableOpacity, StyleSheet, Vibration } from 'react-native';
import { HealthBattery } from './src/components/HealthBattery';
import { analyzeGutHealth } from './src/lib/StomachEngine';

export default function App() {
  const [score, setScore] = useState(88);
  const [message, setMessage] = useState("SYSTEM READY");

  const runFullTriage = () => {
    // 1. Simulation of the S21 Mic picking up Gut Turbulence
    // 2. Cross-referencing the 'O' Blood Type Logic
    const result = analyzeGutHealth([0.9, 0.8, 0.9], 'O');
    
    if (result.alert === "Lectin Agglutination Risk") {
      setScore(42); // Physically drops the gold battery level
      setMessage("ALARM: LECTIN SPIKE DETECTED");
      
      // Haptic feedback specifically for the S21
      Vibration.vibrate([0, 500, 100, 500]); 
    }
  };

  const resetSystem = () => {
    setScore(88);
    setMessage("SYSTEM READY");
  };

  return (
    <View style={styles.container}>
      <Text style={styles.title}>BIORACLE V12</Text>
      
      <HealthBattery score={score} />
      
      <Text style={styles.statusText}>{message}</Text>

      <TouchableOpacity style={styles.button} onPress={runFullTriage}>
        <Text style={styles.buttonText}>ACTIVATE CLAIM 12</Text>
      </TouchableOpacity>

      <TouchableOpacity style={{marginTop: 30}} onPress={resetSystem}>
        <Text style={{color: '#444', letterSpacing: 1}}>RESET BIO-BASELINE</Text>
      </TouchableOpacity>
    </View>
  );
}

